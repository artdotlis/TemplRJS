CACHE_DIR=.cache

BIN_DIR=bin
BIN_DEPLOY=bin/build.sh
BIN_DEPLOY_FIX=bin/deploy/fix.sh
BIN_DEPLOY_PREP=bin/deploy/prep.sh
BIN_DEPLOY_REQ=bin/deploy/req.sh
BIN_DEPLOY_REQ_SERVER=bin/deploy/req.server.sh
BIN_INSTALL_BUN=bin/install/bun.sh
BIN_RUN_ENV_LINT=bin/lint/lint_env.sh
BIN_NGINX_ENTRY=bin/nginx/entry.sh

NODE_VER=22
BUN_VER=v1.3.1

BUN_DIR_R=.bun
BUN_BIN_R=.bun/bin

CONFIG_SHELL=configs/lint/shellcheckrc
CONFIG_PRETTIER=configs/lint/prettierrc.cjs
CONFIG_PRETTIER_IGNORE=configs/lint/prettierignore
CONFIG_WEB=configs/nginx

CONFIG_DECK=packages/presentation/configs/deck.config.json
CONFIG_REVEALJS=packages/presentation/configs/revealjs.config.json

TEMPL_CONFIG_REVEALJS=configs/revealjs/config.tpl.json
TEMPL_CONFIG_DECK=configs/revealjs/deck.tpl.json

APP=public

PKGS=packages
PRES_ENV=packages/presentation/.env

DOCKER_ENV_DIR=/docker-build-env

NODE_ENV=development
NODE_PORT=8080

NGINX_BALANCER=balancer
NGINX_PORT=9080

PM2_WORKER=1